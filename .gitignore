node_modules/
# secrets — ignore every .env variant, but keep the placeholder template
.env*
!.env.example
*.log
# execution journal + any local SQLite (full trading history — local only)
data/
*.sqlite*
# first-run disclaimer acceptance — written next to the .env, which in a source
# checkout IS the repo root. Committing it would ship a pre-accepted disclaimer:
# every clone would satisfy the gate without ever being shown docs/DISCLAIMER.md.
disclaimer.json
# design scratch (not part of the shipped app)
web/design/
# live-suite artifacts
tests/live/reports/
tests/live/.last-run.json
tests/live/.data-*/
# recorded fixtures from live runs — contain REAL account data, never commit
tests/fixtures/gate/recorded/
# build output
web/dist/
# local tooling state
.claude/

# git worktrees made by `gwta`, which land inside the repo
.worktrees/

# Local-only tooling.
deploy/
# per-install API token — written next to the .env (the repo root in a source
# checkout). Never commit it: it is the credential the local API checks.
api-token
# installer provenance — written into the INSTALLED app dir, never the repo.
# Committing one would ship a false "you are running commit X" to every user.
install-info.json

# Playwright MCP session scratch (snapshots, console logs) — a debugging
# artifact of whoever last drove the browser, never part of the app.
.playwright-mcp/
