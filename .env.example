# Gate.io API v4 credentials (create at gate.io → API Management).
# The web app can also set these for you: start the server and open the setup card.
GATE_API_KEY=
GATE_API_SECRET=

# Boros order placement. YOU DO NOT NEED TO FILL THESE IN BY HAND — open the
# Boros tab in the order ticket and press "Connect wallet". That generates a
# delegated agent key, approves it on-chain with your wallet, and writes these
# lines for you (0600, same as the Gate secret above).
#
# The AGENT key can TRADE this account but cannot deposit or withdraw — Boros
# requires your own wallet for those. Never put a root wallet key here; nothing
# in this tool ever asks for one.
# BOROS_AGENT_PRIVATE_KEY=0x...            # 32-byte hex agent key
# BOROS_ROOT_ADDRESS=0x...                 # the account the agent trades for
# BOROS_ACCOUNT_ID=0                       # Boros sub-account (default 0)

# Optional overrides:
# PORT=6688                                # server port (default 6688)
# ARB_DATA_DIR=/absolute/path/to/data      # trade journal location (default: <repo>/data)
# DOTENV_CONFIG_PATH=/absolute/path/.env   # where credentials are read from and saved to (default: <repo>/.env)
# UPDATE_CHECK=0                           # skip the GitHub version check entirely
# BOROS_TAKER_FEE_OVERRIDE=0.0001          # force this Boros taker-fee rate (fraction) in the opportunities scan
# EST_SPREAD_BPS=10                        # assumed half-spread (bps) when a fill is estimated from a reference
#                                          # price because no venue book was available (default 10)

# Maintainers only — nothing here affects a local terminal:
# PUBLIC_MODE=1                            # run as the read-only PUBLIC landing site: no credentials,
#                                          # no engine, and only the market-view routes are registered
# HOST=0.0.0.0                             # bind beyond loopback (public deployment behind a reverse
#                                          # proxy); every other deployment stays on 127.0.0.1
# GA_MEASUREMENT_ID=G-XXXXXXXXXX           # GA4 id for the PUBLIC landing site; read by deploy/deploy.sh
